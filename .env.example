# Build-time defaults (embedded into the bundle — never put secrets here).
# In containers these are overridden at runtime via APP_* variables (see README).
VITE_APP_NAME=Modular Frontend
VITE_API_BASE_URL=/api

# Reserved for centralized authentication. Not read by the app until auth is implemented.
# VITE_KEYCLOAK_URL=https://auth.example.com
# VITE_KEYCLOAK_REALM=example
# VITE_KEYCLOAK_CLIENT_ID=frontend
